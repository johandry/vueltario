# Server & Deployment
VUELTARIO_ADDR=:8080
VUELTARIO_BASE_URL=http://localhost:8080
VUELTARIO_COOKIE_SECURE=false

# Database ("postgres" for remote Supabase PostgreSQL, "sqlite" for local offline testing)
# Supabase Direct / Session Pooler connection string (from Supabase Dashboard -> Connect):
# VUELTARIO_DB_DRIVER=postgres
# VUELTARIO_DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require
VUELTARIO_DB_DRIVER=sqlite
VUELTARIO_DATABASE_URL=./data/vueltario.db

# Supabase Project (used by GitHub Pages static website `/`, `/admin`, iOS app, and optional Supabase Storage)
VUELTARIO_SUPABASE_URL=
VUELTARIO_SUPABASE_ANON_KEY=
VUELTARIO_SUPABASE_SERVICE_KEY=
VUELTARIO_SUPABASE_BUCKET=vueltario-media

# Video Storage Provider ("r2" recommended for $0 egress bandwidth, "supabase", or "filesystem")
VUELTARIO_STORAGE_PROVIDER=r2
VUELTARIO_R2_ACCOUNT_ID=
VUELTARIO_R2_ENDPOINT=
VUELTARIO_R2_BUCKET=vueltario-media
VUELTARIO_R2_ACCESS_KEY_ID=
VUELTARIO_R2_SECRET_ACCESS_KEY=
VUELTARIO_R2_PUBLIC_URL=

# Bootstrap Administrator (created idempotently on first start if set)
VUELTARIO_ADMIN_EMAIL=admin@vueltario.com
VUELTARIO_ADMIN_PASSWORD=vueltario-local-admin

# Community Access ("invited_moderated", "open_moderated", "admin_only")
VUELTARIO_SIGNUP_MODE=invited_moderated

# Storage & Media Ceilings
VUELTARIO_STORAGE_ROOT=./data/storage
VUELTARIO_MAX_UPLOAD_BYTES=524288000
VUELTARIO_MAX_CLIP_DURATION_MS=600000
VUELTARIO_MAX_CONCURRENT_TRANSCODES=2
VUELTARIO_ADMIN_STORAGE_QUOTA_BYTES=10737418240

# Enrichment & Cost Controls
VUELTARIO_ANALYSIS_ENABLED=true
VUELTARIO_ANALYSIS_DAILY_BUDGET=200
VUELTARIO_ANALYSIS_HIGH_CONF_VERIFIED=false

# Provider Credentials (optional; manual cataloging works without any keys)
VUELTARIO_YOUTUBE_API_KEY=

# Instagram Publishing (@cubansocial.sd)
VUELTARIO_IG_DESTINATION=@cubansocial.sd
VUELTARIO_IG_BRAND_PREFIX=CubanSocial
VUELTARIO_IG_CAPTION_MAX_CHARS=2200
VUELTARIO_IG_MAX_HASHTAGS=30
VUELTARIO_IG_MAX_MENTIONS=20
VUELTARIO_IG_ALLOW_COMPANION_TAGS=true
VUELTARIO_IG_ACCESS_TOKEN=
VUELTARIO_IG_USER_ID=
VUELTARIO_IG_API_BASE_URL=https://graph.instagram.com/v21.0
